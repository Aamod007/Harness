# Environment configuration template
# Copy to .env and insert your API credentials

GROQ_API_KEY=your_groq_api_key_here
JCODE_PROVIDER=groq
JCODE_MODEL=openai/gpt-oss-120b
PORT=8080

# LM Studio alternative: enable Local Server in LM Studio, then restart Cipher.
# The loaded model in LM Studio is selected through JCODE_MODEL.
# JCODE_PROVIDER=openai-compatible
# JCODE_MODEL=qwen/qwen3-vl-8b
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# JCODE_OPENAI_COMPAT_API_BASE=http://127.0.0.1:1234/v1
